# Copy this file to .env and fill in your key: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-key-here

# Optional settings (defaults shown)
PORT=3000
IMAGE_MODEL=gpt-image-2
PAGE_QUALITY=low
# Page sizes (8.5:11 portrait; both sides divisible by 16). Economy is the smallest size the API accepts.
PAGE_SIZE_ECONOMY=720x928
PAGE_SIZE_STANDARD=1088x1408
COVER_SIZE=1088x1408
# Printed on every back cover
BRAND_NAME=Annvay Publishing
# Used only for "Suggest subjects"
TEXT_MODEL=gpt-5-mini
# How often the server checks running batches
BATCH_POLL_SECONDS=60
# Prices used for the on-screen spend estimate ($ per 1M tokens). Real usage: platform.openai.com/usage
IMAGE_OUTPUT_PRICE_PER_M=30
TEXT_INPUT_PRICE_PER_M=5
